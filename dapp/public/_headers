# Netlify response headers for every page and file.
/*
  # No site may frame the app: its buttons sign transactions. No <base>,
  # no object and no form posting elsewhere, whatever user markdown holds.
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  # Wallet popups keep their opener, which they answer through.
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
