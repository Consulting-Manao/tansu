---
// Offers a new version of the app, which the service worker holds back until
// the user reloads. Persisted, so it stays across ClientRouter page changes.
// Without a waiting worker to switch to, Reload drops the caches first.
---

<div
  id="update-prompt"
  transition:persist="update-prompt"
  role="status"
  class="fixed inset-x-3 bottom-3 z-[70] hidden items-center gap-3 rounded-control bg-ink p-4 text-ui text-ground shadow-float sm:inset-x-auto sm:right-5 sm:bottom-5"
>
  <p class="font-semibold">A new version is ready</p>
  <button
    type="button"
    data-reload
    class="inline-flex h-9 items-center rounded-control bg-accent px-3 text-small font-semibold text-on-accent hover:opacity-90"
  >
    Reload
  </button>
  <button
    type="button"
    data-dismiss
    aria-label="Dismiss"
    class="inline-flex size-9 items-center justify-center rounded-control text-ground hover:opacity-80"
  >
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M6 6l12 12M18 6 6 18"></path>
    </svg>
  </button>
</div>

<script>
  import { Workbox } from "workbox-window";
  import { registerServiceWorker } from "../../utils/serviceWorker";
  import { clearAndReload, watchVersion } from "../../utils/version";

  const card = document.getElementById("update-prompt")!;
  let reload: () => void = () => void clearAndReload();
  const show = (update?: () => void) => {
    if (update) reload = update;
    card.classList.replace("hidden", "flex");
  };
  card
    .querySelector("[data-reload]")!
    .addEventListener("click", () => reload());
  card.querySelector("[data-dismiss]")!.addEventListener("click", () => {
    card.classList.replace("flex", "hidden");
  });

  // A chunk of the running version is gone: a newer one was deployed.
  window.addEventListener("vite:preloadError", () => show());

  if (import.meta.env.PROD && "serviceWorker" in navigator) {
    // The worker this one replaces kept images in its own cache.
    void caches.delete("tansu-v2");
    registerServiceWorker(new Workbox("/sw.js"), show);
  }
  if (import.meta.env.PROD) watchVersion(() => show());
</script>
