---
import ConnectButton from "../ConnectButton.tsx";
import JoinCommunityButton from "../JoinCommunityButton.tsx";
import NavbarSearch from "../NavbarSearch.tsx";
---

<!-- The top bar sits on the band: the page heads below continue it. -->
<header role="banner" class="border-b border-band-line bg-band text-band-ink">
  <nav
    class="mx-auto flex h-16 w-full max-w-[1120px] items-center gap-3 px-4 sm:gap-4 sm:px-6 lg:px-10"
    aria-label="Main navigation"
  >
    <a
      href="/"
      class="flex shrink-0 items-center gap-2.5 rounded-control text-card font-bold text-band-ink no-underline"
      aria-label="Tansu homepage"
    >
      <img alt="" src="/logo.svg" class="h-7 w-auto" width="24" height="28" />
      <span class="hidden sm:inline">Tansu</span>
      <span class="hidden rounded-full bg-sunken px-2 py-0.5 text-xs font-semibold text-ink-muted lg:inline">
        alpha
      </span>
    </a>
    <div class="flex min-w-0 flex-1 items-center">
      <NavbarSearch client:load />
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <JoinCommunityButton client:only="react" />
      <ConnectButton client:only="react" />
    </div>
  </nav>
</header>
