---
/*
 * The top of an inner page: the band, with the home hero's ground behind it
 * (the 30-degree grid and the faint lanes of other projects; no history, no
 * motion). On phones the head is compact, so only the grid stays.
 */
import "../../styles/history-art.css";
// The ground comes from scripts/history-art.py (bun run art).
import ground from "../../assets/art/band.svg?raw";
---

<section class="page-band history-art">
  <div class="page-band__ground" aria-hidden="true">
    <Fragment set:html={ground} />
  </div>
  <div class="page-band__body">
    <slot />
  </div>
</section>

<style>
  .page-band {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-band-line);
    background:
      radial-gradient(
        90% 140% at 100% 0%,
        light-dark(#fff6dc, rgba(102, 0, 165, 0.3)) 0%,
        transparent 50%
      ),
      var(--color-band);
    color: var(--color-band-ink);
  }
  .page-band__ground {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .page-band__ground :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .page-band__body {
    position: relative;
    margin: 0 auto;
    max-width: 1120px;
    padding: 32px clamp(16px, 4vw, 40px) 40px;
  }
  @media (max-width: 639px) {
    .page-band__ground :global(.art-ghosts) {
      display: none;
    }
    .page-band__body {
      padding-top: 20px;
      padding-bottom: 24px;
    }
  }
</style>
