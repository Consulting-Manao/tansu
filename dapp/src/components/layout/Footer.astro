---
const year = new Date().getFullYear();
const horizonUrl = import.meta.env.PUBLIC_HORIZON_URL;
const network = horizonUrl.includes("testnet") ? "testnet" : "public";
const contractId = import.meta.env.PUBLIC_TANSU_CONTRACT_ID;
// The build, to tell which version a report is about: a commit, shortened,
// or the build time.
const build = import.meta.env.PUBLIC_BUILD.replace(
  /^([0-9a-f]{7})[0-9a-f]{33}$/,
  "$1",
);
---

<footer class="border-t border-line bg-surface text-small text-ink-muted">
  <div class="mx-auto flex w-full max-w-[1120px] flex-wrap items-center gap-x-6 gap-y-3 px-4 py-6 sm:px-6 lg:px-10">
    <a href="https://tansu.dev" class="shrink-0" aria-label="Tansu website">
      <img src="/logo.svg" alt="" class="h-6 w-auto" width="20" height="24" />
    </a>
    <span>
      © <span id="currentYear">{year}</span> Tansu ·{" "}
      <a href="https://consulting-manao.com" class="hover:text-ink">
        Consulting Manao GmbH
      </a>
    </span>
    <nav aria-label="Legal" class="flex flex-wrap gap-x-4 gap-y-1">
      <a href="/terms/" class="hover:text-ink">
        Terms of Service
      </a>
      <a href="/privacy/" class="hover:text-ink">
        Privacy Policy
      </a>
      <a href="/impressum/" class="hover:text-ink">
        Impressum
      </a>
    </nav>
    <nav aria-label="Tansu elsewhere" class="flex flex-wrap gap-x-4 gap-y-1">
      <a
        href="https://radicle.network/nodes/radicle.consulting-manao.com/rad%3AzssaAF91kxuquZmZCV2SiK2FNX6s"
        class="hover:text-ink"
      >
        Radicle
      </a>
      <a
        href={`https://stellar.expert/explorer/${network}/contract/${contractId}`}
        class="hover:text-ink"
      >
        Stellar Expert
      </a>
      <a
        href="https://discord.com/channels/897514728459468821/1262501866915237908"
        class="hover:text-ink"
      >
        Discord
      </a>
    </nav>
    <span class="font-mono sm:ml-auto" title="Version">
      {build}
    </span>
  </div>
</footer>
