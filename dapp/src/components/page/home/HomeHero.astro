<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-band-line);
    background:
      radial-gradient(
        90% 120% at 100% 0%,
        light-dark(#fff6dc, rgba(102, 0, 165, 0.35)) 0%,
        transparent 55%
      ),
      var(--color-band);
    color: var(--color-band-ink);
    --art-grid: light-dark(rgba(102, 0, 165, 0.26), rgba(255, 255, 255, 0.15));
    --art-ghost: light-dark(rgba(102, 0, 165, 0.16), rgba(205, 180, 255, 0.16));
    --art-a: light-dark(#c48bf5, #4b1d86);
    --art-b: light-dark(#6600a5, #af44f2);
    --art-c: light-dark(#ffb31e, #ffc23d);
    --art-node: light-dark(#ffffff, #140a24);
    --art-ring: light-dark(#6600a5, #cdb4ff);
    --art-branch: light-dark(
      rgba(102, 0, 165, 0.42),
      rgba(205, 180, 255, 0.45)
    );
    --art-glow: light-dark(0.22, 0.75);
    --draw: 1600ms;
  }
  .hero__body {
    margin: 0 auto;
    display: flex;
    max-width: 1120px;
    flex-direction: column;
    gap: 24px;
    padding: 112px 40px 120px;
  }
  .hero__text,
  .hero__actions {
    position: relative;
    z-index: 1;
    max-width: 640px;
  }
  .hero__text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: light-dark(#6600a5, #ffd88a);
  }
  .hero__title {
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    font-weight: 800;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .hero__lead {
    max-width: 34em;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    color: var(--color-band-muted);
  }
  .hero__actions {
    display: flex;
    gap: 12px;
    margin-top: 8px;
  }
  .hero__search {
    display: flex;
    flex: 1;
    min-width: 0;
    height: 48px;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-control);
    background: light-dark(var(--color-surface), rgba(255, 255, 255, 0.08));
    color: var(--color-ink-muted);
  }
  .hero__search:focus-within {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .hero__search input {
    min-width: 0;
    flex: 1;
    border: 0;
    background: transparent;
    font: inherit;
    color: var(--color-ink);
    outline: none;
  }
  .hero__art {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero__art :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__art :global(.hero-art__graph--phone) {
    display: none;
  }

  /* The art's marks */
  .hero :global(.art-stop-a) {
    stop-color: var(--art-a);
  }
  .hero :global(.art-stop-b) {
    stop-color: var(--art-b);
  }
  .hero :global(.art-stop-c) {
    stop-color: var(--art-c);
  }
  .hero :global(.art-dot) {
    fill: var(--art-grid);
  }
  .hero :global(:is(.art-line, .art-glow, .art-branch, .art-ghost)) {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hero :global(.art-line) {
    stroke-width: 5;
  }
  .hero :global(.art-glow) {
    stroke-width: 12;
    opacity: var(--art-glow);
  }
  .hero :global(.art-branch) {
    stroke: var(--art-branch);
    stroke-width: 2.5;
  }
  .hero :global(.art-ghost) {
    stroke: var(--art-ghost);
    stroke-width: 2;
  }
  .hero :global(.art-ghost-node) {
    fill: var(--art-node);
    stroke: var(--art-ghost);
    stroke-width: 2;
  }
  .hero :global(.art-node) {
    fill: var(--art-node);
    stroke: var(--art-ring);
    stroke-width: 3;
  }
  .hero :global(.art-node--merge) {
    fill: var(--art-ring);
    stroke: var(--art-node);
  }
  .hero :global(.art-avatar circle) {
    fill: #ffd61e;
    stroke: var(--art-node);
    stroke-width: 3;
  }
  .hero :global(.art-seal__shape) {
    fill: #ffc23d;
  }
  .hero :global(.art-seal__tick) {
    fill: none;
    stroke: #2b1a00;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hero :global(.art-halo) {
    fill: rgba(255, 194, 61, 0.22);
  }
  .hero :global(.art-halo--2) {
    fill: rgba(255, 194, 61, 0.1);
  }
  .hero :global(:is(.art-pop, .art-seal__badge, .art-halo)) {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Arrival: the history draws itself, each commit lights as the line
     reaches it, then the latest commit's check stamps in. */
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes pop {
    from {
      transform: scale(0);
    }
    to {
      transform: scale(1);
    }
  }
  @keyframes stamp {
    from {
      opacity: 0;
      transform: scale(1.5);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes ring {
    from {
      opacity: 0;
      transform: scale(0.3);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes appear {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero :global(:is(.art-line, .art-glow)) {
      stroke-dasharray: 1;
      animation: draw var(--draw) cubic-bezier(0.45, 0, 0.2, 1) both;
    }
    .hero :global(.art-branch) {
      stroke-dasharray: 1;
      animation: draw calc((var(--t1) - var(--t0)) * var(--draw))
        calc(var(--t0) * var(--draw)) linear both;
    }
    .hero :global(.art-pop) {
      animation: pop 320ms calc(var(--t) * var(--draw))
        cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }
    .hero :global(.art-seal__badge) {
      animation: stamp 420ms var(--draw) cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }
    .hero :global(.art-halo) {
      animation: ring 700ms calc(var(--draw) + 120ms)
        cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
    .hero :global(.art-ghosts) {
      animation: appear 900ms ease-out both;
    }
  }

  /* Phones: the whole first screen, the art between the text and the
     actions, longer on taller screens and fading into the past. */
  @media (max-width: 639px) {
    .hero__body {
      min-height: calc(100svh - 65px);
      gap: clamp(16px, 3svh, 28px);
      padding: clamp(20px, 4svh, 40px) 16px clamp(20px, 4svh, 32px);
    }
    .hero__title {
      font-size: clamp(30px, 9.4vw, 44px);
      line-height: 1.08;
    }
    .hero__lead {
      font-size: 16px;
      line-height: 24px;
    }
    .hero__art {
      position: relative;
      inset: auto;
      flex: 1 1 0;
      min-height: 96px;
      margin: 0 -16px;
      -webkit-mask-image: linear-gradient(#000 62%, transparent);
      mask-image: linear-gradient(#000 62%, transparent);
    }
    .hero__art :global(.hero-art__graph--desk) {
      display: none;
    }
    .hero__art :global(.hero-art__graph--phone) {
      display: block;
      position: absolute;
      inset: 0;
    }
    .hero__actions {
      flex-direction: column;
      margin-top: auto;
    }
  }
</style>
