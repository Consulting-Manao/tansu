---
/*
 * The home page's hero: what Tansu is, a search, a way to register. Its art
 * is a project's history on the logo's 30° grid (made by a generator, drawn
 * once; scripts/history-art.py writes it): commits climbing to a verified one, branches merged by a vote, and
 * the faint lanes of other projects. It draws itself once per visit; nothing
 * moves with reduced motion. Wide on desktop; on phones the hero fills the
 * first screen and the art takes the room between the text and the actions.
 */
import HeroNewProject from "./HeroNewProject";
import "../../../styles/history-art.css";
// The art comes from scripts/history-art.py (bun run art).
import desk from "../../../assets/art/hero-desk.svg?raw";
import phone from "../../../assets/art/hero-phone.svg?raw";
---

<section
  class="hero history-art history-art--draw"
  aria-labelledby="hero-title"
>
  <div class="hero__body">
    <div class="hero__text">
      <p class="hero__eyebrow">Built on Stellar</p>
      <h1 id="hero-title" class="hero__title">
        Open source you can verify.
      </h1>
      <p class="hero__lead font-prose">
        Tansu records each project’s commits, maintainers and decisions on
        Stellar, so anyone can check what was released and who decided.
      </p>
    </div>
    <div class="hero__art" aria-hidden="true">
      <Fragment set:html={desk} />
      <Fragment set:html={phone} />
    </div>
    <div class="hero__actions">
      <form action="/" method="get" role="search" class="hero__search">
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <input
          type="search"
          name="search"
          aria-label="Search projects or members"
          placeholder="Search projects or members"
          required
        />
      </form>
      <HeroNewProject client:only="react" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-band-line);
    background:
      radial-gradient(
        90% 120% at 100% 0%,
        light-dark(#fff6dc, rgba(102, 0, 165, 0.35)) 0%,
        transparent 55%
      ),
      var(--color-band);
    color: var(--color-band-ink);
  }
  .hero__body {
    margin: 0 auto;
    display: flex;
    max-width: 1120px;
    flex-direction: column;
    gap: 24px;
    padding: 112px 40px 120px;
  }
  .hero__text,
  .hero__actions {
    position: relative;
    z-index: 1;
    max-width: 640px;
  }
  .hero__text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: light-dark(#6600a5, #ffd88a);
  }
  .hero__title {
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    font-weight: 800;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .hero__lead {
    max-width: 34em;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    color: var(--color-band-muted);
  }
  .hero__actions {
    display: flex;
    gap: 12px;
    margin-top: 8px;
  }
  .hero__search {
    display: flex;
    flex: 1;
    min-width: 0;
    height: 48px;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-control);
    background: light-dark(var(--color-surface), rgba(255, 255, 255, 0.08));
    color: var(--color-ink-muted);
  }
  .hero__search:focus-within {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .hero__search input {
    min-width: 0;
    flex: 1;
    border: 0;
    background: transparent;
    font: inherit;
    color: var(--color-ink);
    outline: none;
  }
  .hero__art {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero__art :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__art :global(.hero-art__graph--phone) {
    display: none;
  }

  /* Phones: the whole first screen, the art between the text and the
     actions, longer on taller screens and fading into the past. */
  @media (max-width: 639px) {
    .hero__body {
      min-height: calc(100svh - 65px);
      gap: clamp(16px, 3svh, 28px);
      padding: clamp(20px, 4svh, 40px) 16px clamp(20px, 4svh, 32px);
    }
    .hero__title {
      font-size: clamp(30px, 9.4vw, 44px);
      line-height: 1.08;
    }
    .hero__lead {
      font-size: 16px;
      line-height: 24px;
    }
    .hero__art {
      position: relative;
      inset: auto;
      flex: 1 1 0;
      min-height: 96px;
      margin: 0 -16px;
      -webkit-mask-image: linear-gradient(#000 62%, transparent);
      mask-image: linear-gradient(#000 62%, transparent);
    }
    .hero__art :global(.hero-art__graph--desk) {
      display: none;
    }
    .hero__art :global(.hero-art__graph--phone) {
      display: block;
      position: absolute;
      inset: 0;
    }
    .hero__actions {
      flex-direction: column;
      margin-top: auto;
    }
  }
</style>
