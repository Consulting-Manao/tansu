---
import Layout from "../layouts/Layout.astro";
import PageBand from "../components/layout/PageBand.astro";
import { Content as Impressum } from "../../../legal/impressum.md";
import { Content as Privacy } from "../../../legal/privacy-policy.md";
import { Content as Terms } from "../../../legal/terms-of-service.md";

/** The legal texts, from the repository's legal/ directory. */
export function getStaticPaths() {
  return [
    {
      params: { legal: "terms" },
      props: { title: "Terms of Service", LegalText: Terms },
    },
    {
      params: { legal: "privacy" },
      props: { title: "Privacy Policy", LegalText: Privacy },
    },
    {
      params: { legal: "impressum" },
      props: { title: "Impressum", LegalText: Impressum },
    },
  ];
}

const { legal } = Astro.params;
const { title, LegalText } = Astro.props;
---

<Layout title={`${title} - Tansu`} page={legal}>
  <PageBand>
    <div class="flex max-w-[760px] flex-col gap-4">
      <a
        href="/"
        class="self-start text-ui font-semibold text-band-muted no-underline hover:text-band-ink"
      >
        ← Tansu
      </a>
      <h1 class="text-section font-extrabold tracking-[-0.02em] text-band-ink sm:text-title">
        {title}
      </h1>
    </div>
  </PageBand>
  <article class="legal-content font-prose text-prose mx-auto w-full max-w-[42em] px-4 py-10 sm:py-14">
    <LegalText />
  </article>
</Layout>

<style>
  /* The markdown's own title is the band's. */
  .legal-content :global(h1) {
    display: none;
  }
  .legal-content :global(h2) {
    margin: 3rem 0 1rem;
    font-family: var(--font-ui);
    font-size: var(--text-section);
    line-height: var(--text-section--line-height);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .legal-content :global(h2:first-of-type) {
    margin-top: 0;
  }
  .legal-content :global(h3),
  .legal-content :global(h4),
  .legal-content :global(h5),
  .legal-content :global(h6) {
    margin: 2rem 0 0.75rem;
    font-family: var(--font-ui);
    font-size: var(--text-card);
    line-height: var(--text-card--line-height);
    font-weight: 600;
  }
  .legal-content :global(p),
  .legal-content :global(li) {
    margin-bottom: 0.75rem;
  }
  .legal-content :global(strong) {
    font-weight: 600;
  }
  .legal-content :global(ul),
  .legal-content :global(ol) {
    margin: 0 0 1rem 1.5rem;
    list-style: revert;
  }
  /* Wide tables scroll inside the column. */
  .legal-content :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    margin-bottom: 1rem;
    font-size: var(--text-small);
  }
  .legal-content :global(th),
  .legal-content :global(td) {
    border: 1px solid var(--color-line-strong);
    padding: 0.5rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }
  .legal-content :global(a) {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
