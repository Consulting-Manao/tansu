---
/*
 * A project's proposals are a tab of its page now: old links land there.
 * The page stays precached, so the redirect works offline too.
 */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Tansu</title>
    <script is:inline>
      const params = new URLSearchParams(location.search);
      params.set("tab", "proposals");
      location.replace(`/project/?${params}`);
    </script>
  </head>
  <body>
    <a href="/">Tansu</a>
  </body>
</html>
