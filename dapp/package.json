  "name": "dapp",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "astro check",
    "build": "astro build",
    "build:lighthouse": "LIGHTHOUSE_BUILD=true astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "start": "astro dev",
    "test": "bun playwright test --reporter=dot",
    "test:unit": "bunx vitest run",
    "lint": "prettier -c . && eslint src/ --ext .ts,.tsx,.jsx && knip && bun scripts/validate-contract-errors.js",
    "validate-errors": "bun scripts/validate-contract-errors.js",
    "format": "prettier --write .",
    "audit": "bun run build:lighthouse && bunx serve dist -l 3000 & sleep 8 && bunx lighthouse http://localhost:3000 --output=json --output-path=./lighthouse-local-results.json --chrome-flags=\"--headless --disable-dev-shm-usage\" && pkill -f serve && cat lighthouse-local-results.json | jq '.categories | with_entries(.value = .value.score)'",
    "netlify:status": "netlify status",
    "netlify:link:staging": "netlify link --id b637f4df-4886-4cc7-bc3b-6bfa12e6f351",
    "netlify:link:production": "netlify link --id 12f7130e-323b-42d5-b2cb-69df80676a79",
    "netlify:build": "netlify build",
    "netlify:deploy": "netlify deploy --prod",
    "icons": "rsvg-convert -w 192 assets/icon.svg -o public/icon-192.png && rsvg-convert -w 512 assets/icon.svg -o public/icon-512.png && rsvg-convert -w 512 assets/icon-maskable.svg -o public/icon-maskable-512.png && rsvg-convert -w 180 assets/icon-maskable.svg -o public/apple-touch-icon.png"
  },
  "type": "module",
  "version": "0.0.1",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "axios": "^1.19.0",
    "devalue": "^5.9.0",
    "protobufjs": "^7.6.5"
  }
}
